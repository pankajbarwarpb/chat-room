{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mikro:generate": "npm run build && npx mikro-orm migration:create",
    "mikro:migrate": "npm run build && npx mikro-orm migration:up",
    "mikro:refresh": "npm run build && npx mikro-orm schema:refresh --run",
    "mikro:drop": "npm run build && npx mikro-orm schema:drop --confirm"
  },
  "keywords": [],
